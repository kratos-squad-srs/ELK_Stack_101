# =====================================================================
# ELK STACK SECURITY LAB CONFIGURATION (.env)
# =====================================================================

# Stack Version Control
STACK_VERSION=8.11.1

# Cluster & Resource Settings
CLUSTER_NAME=elk-cluster
ES_JAVA_OPTS=-Xms1g -Xmx1g

# Internal System Accounts (รหัสผ่านระบบตรวจสุขภาพภายใน)
ELASTIC_PASSWORD=P@ssw0rd

KIBANA_SYSTEM_PASSWORD=P@ssw0rd

LOGSTASH_SYSTEM_PASSWORD=P@ssw0rd

# Data Pipeline Roles (ไอดีมดงานที่เราจะสร้างสิทธิ์เฉพาะกิจ RBAC)
LOGSTASH_WRITER_USER=logstash_writer
LOGSTASH_WRITER_PASSWORD=WriterSecurePass123

# Host Storage Path (ตำแหน่งเก็บไฟล์ log บนเครื่อง Mac)
# แอดมินปรับเปลี่ยนพาธตรงนี้ให้ตรงกับโฟลเดอร์ที่เก็บแอปพลิเคชันล็อกบน Mac ได้เลยครับ
MAC_LOGS_PATH=./mylogs